[Unit]
Description=amethyst-audio HLS Stream Server
Documentation=https://github.com/aplt-amethyst/amethyst-audio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amethyst-audio
Group=amethyst-audio
ExecStart=/usr/bin/amethyst-audio --config /etc/amethyst-audio/config.yaml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amethyst-audio
Environment=RUST_LOG=info

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/amethyst-audio /var/log/amethyst-audio
ReadOnlyPaths=/etc/amethyst-audio

[Install]
WantedBy=multi-user.target
