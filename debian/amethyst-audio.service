[Unit]
Description=amethyst-audio HLS Stream Server
Documentation=https://github.com/aplt-amethyst/amethyst-audio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amethyst-audio
Group=amethyst-audio
ExecStart=/usr/bin/amethyst-audio --host 0.0.0.0 --port 3000 --segment-duration 10 --output-dir /var/lib/amethyst-audio/output
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amethyst-audio
Environment=RUST_LOG=info

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/amethyst-audio
ReadOnlyPaths=/etc/amethyst-audio

[Install]
WantedBy=multi-user.target
