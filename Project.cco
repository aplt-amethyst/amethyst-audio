/* Project.cco for amethyst-audio */
project: (
    name: "amethyst-audio",
    namespace: "aplt",
    version: "0.1.0",
    description: "HLS stream server with pure Rust MPEG-TS muxer",
    author: "CNT Development Team <dev@aplt-cnt.com>",
    license: "AGPL-3.0",
    repository: (
        type: "git",
        url: "https://github.com/aplt-amethyst/amethyst-audio"
    ),
    private: false
),
tech: (
    main: "Rust",
    standard: "2021",
    build: (
        system: "cargo",
        min_version: "1.70"
    ),
    dependencies: (
        tokio: "1",
        axum: "0.8",
        tower-http: "0.6",
        thiserror: "2",
        anyhow: "1",
        tracing: "0.1",
        tracing-subscriber: "0.3",
        serde: "1",
        serde_json: "1",
        serde_yaml: "0.9",
        clap: "4",
        hound: "3",
        claxon: "0.4"
    ),
    scripts: (
        build: "cargo build --release",
        test: "cargo test"
    )
)
